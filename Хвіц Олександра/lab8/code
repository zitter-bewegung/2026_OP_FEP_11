#include <stdio.h>

int isPrime(int n) {
    int i;
    for (i = 2; i < n; i++) // пробуємо ділити на 2, 3, 4
        if (n % i == 0) return 0; // поділилось без остачі → не просте
    return n > 1; // не поділилось ні на що → просте (і більше 1)
}

int main(void) {
    int num;
    printf("число: ");
    scanf("%d", &num);
    if (isPrime(num))
        printf("просте\n");
    else
        printf("не просте\n");
    return 0;
}






#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int* get1(int a[], int n, int i) {
    if (i < 0 || i >= n) return NULL;
    return &a[i];
}

int* get2(int m[12][12], int r, int c) {
    if (r < 0 || r >= 12 || c < 0 || c >= 12) return NULL;
    return &m[r][c];
}

int main(void) {
    int a[10], m[12][12], i, j, x, y, z;
    srand(time(NULL));

    for (i = 0; i < 10; i++) a[i] = rand() % 100;
    for (i = 0; i < 12; i++)
        for (j = 0; j < 12; j++) m[i][j] = rand() % 100;

    printf("індекс 0-9: ");
    scanf("%d", &x);
    int *p = get1(a, 10, x);
    if (p) printf("%d\n", *p); else printf("NULL\n");

    printf("рядок і стовпець 0-11: ");
    scanf("%d %d", &y, &z);
    int *q = get2(m, y, z);
    if (q) printf("%d\n", *q); else printf("NULL\n");

    return 0;
}








#include <stdio.h>
#include <stdlib.h>
#include <time.h>

void minMaxSum(int a[], int n, int *min, int *max, int *sum) {
    int i;
    *min = a[0];
    *max = a[0];
    for (i = 1; i < n; i++) {
        if (a[i] < *min) *min = a[i];
        if (a[i] > *max) *max = a[i];
    }
    *sum = *min + *max;
}

int main(void) {
    int a[20], i, min, max, sum;
    srand(time(NULL));

    for (i = 0; i < 20; i++)
        a[i] = rand() % 100;

    printf("Масив: ");
    for (i = 0; i < 20; i++)
        printf("%d ", a[i]);
    printf("\n");

    minMaxSum(a, 20, &min, &max, &sum);
    printf("Мінімум = %d\n", min);
    printf("Максимум = %d\n", max);
    printf("Сума = %d\n", sum);

    return 0;
}








