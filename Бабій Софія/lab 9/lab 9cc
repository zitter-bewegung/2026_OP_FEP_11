#include <stdio.h>
#include <string.h>

int main(void) {
    char s[200];
    char *w;

    printf("Введіть прислів'я:\n");
    fgets(s, sizeof(s), stdin);

    w = strtok(s, " \n");
    while (w != NULL) {
        for (int i = strlen(w) - 1; i >= 0; i--)
            putchar(w[i]);
        putchar('\n');
        w = strtok(NULL, " \n");
    }
    return 0;
}



