#include <stdio.h>
#include <string.h>

int main(void) {
    char e[100];
    char *at, *dot;

    printf("Введіть адресу пошти:\n");
    scanf("%s", e);

    at = strchr(e, '@');
    dot = strrchr(e, '.');

    if (at != NULL && dot != NULL && dot > at && strlen(dot) >= 3)
        printf("Правильна адреса\n");
    else
        printf("Неправильна адреса\n");
    return 0;
}
